index 0000000..b88b384
--- /dev/null
+++ b/upgrade_v1/mega_vector_v1/ScanSamples.h
@@ -0,0 +1,16 @@
+#pragma once
+#include <stdint.h>
+
+// Three spaced pings at one settled angle. A close valid return always wins;
+// unknown samples never become evidence of free space.
+struct VmScanSamples {
+ uint8_t count=0,validCount=0;int closest=999;
+ void reset(){count=validCount=0;closest=999;}
+ bool done()const{return count>=3;}
+ void add(int cm){
+  if(done())return;
+  count++;
+  if(cm>3&&cm<400){validCount++;if(cm<closest)closest=cm;}
+ }
+ int confirmedCm()const{return done()&&validCount>=2?closest:999;}
+};
